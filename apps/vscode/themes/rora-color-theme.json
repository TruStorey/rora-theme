  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "#a89cc8",
    "class": "#7ec8f4",
    "interface": { "foreground": "#7ec8f4", "fontStyle": "italic" },
    "type": "#7ec8f4",
    "typeParameter": { "foreground": "#7ec8f4", "fontStyle": "italic" },
    "enum": "#7ec8f4",
    "enumMember": "#d97fff",
    "struct": "#7ec8f4",
    "function": "#72f0c8",
    "method": "#72f0c8",
    "macro": "#38c4a8",
    "variable": "#eddeff",
    "variable.readonly": "#d97fff",
    "variable.constant": "#d97fff",
    "parameter": { "foreground": "#a89cc8", "fontStyle": "italic" },
    "property": "#7ec8f4",
    "property.readonly": "#7ec8f4",
    "selfKeyword": { "foreground": "#38c4a8", "fontStyle": "italic" },
    "keyword": "#b59eff",
    "modifier": "#b59eff",
    "operator": "#c084fc",
    "string": "#f06cb8",
    "number": "#d97fff",
    "regexp": "#e86fa8",
    "comment": { "foreground": "#7a7096", "fontStyle": "italic" },
    "decorator": "#38c4a8",
    "label": "#a89cc8"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7a7096", "fontStyle": "italic" }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#f06cb8" }
    },
    {
      "name": "String escape",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#e86fa8" }
    },
    {
      "name": "Number / Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "constant.character.numeric"
      ],
      "settings": { "foreground": "#d97fff" }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.declaration",
        "keyword.import"
      ],
      "settings": { "foreground": "#b59eff" }
    },
    {
      "name": "Operator / Punctuation",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation",
        "punctuation.section"
      ],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.python",
        "meta.function-call entity.name.function",
        "meta.definition.function entity.name.function"
      ],
      "settings": { "foreground": "#72f0c8" }
    },
    {
      "name": "Type / Class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class"
      ],
      "settings": { "foreground": "#7ec8f4" }
    },
    {
      "name": "Interface (italic)",
      "scope": ["entity.name.type.interface"],
      "settings": { "foreground": "#7ec8f4", "fontStyle": "italic" }
    },
    {
      "name": "Tag / Property",
      "scope": ["entity.name.tag", "support.type.property-name"],
      "settings": { "foreground": "#7ec8f4" }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#7ec8f4", "fontStyle": "italic" }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#eddeff" }
    },
    {
      "name": "Parameter (italic)",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#a89cc8", "fontStyle": "italic" }
    },
    {
      "name": "Language variable (this / self)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": { "foreground": "#38c4a8", "fontStyle": "italic" }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": { "foreground": "#38c4a8" }
    },
    {
      "name": "Built-in constant / type",
      "scope": ["support.constant", "support.type.builtin"],
      "settings": { "foreground": "#d97fff" }
    },
    {
      "name": "JSON / YAML key",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml",
        "support.type.property-name.css"
      ],
      "settings": { "foreground": "#7ec8f4" }
    },
    {
      "name": "Tag delimiter",
      "scope": ["meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "name": "Brackets",
      "scope": ["meta.brace", "meta.bracket"],
      "settings": { "foreground": "#a89cc8" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#f0e6c0", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#eddeff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#eddeff", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#5ab4e8" }
    },
    {
      "name": "Markdown inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#d97fff" }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#a89cc8", "fontStyle": "italic" }
    },
    {
      "name": "Markdown list bullet",
      "scope": ["punctuation.definition.list.begin"],
      "settings": { "foreground": "#b59eff" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "diff.added", "meta.diff.header.to-file"],
      "settings": { "foreground": "#4dd9b0" }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "diff.removed",
        "meta.diff.header.from-file"
      ],
      "settings": { "foreground": "#e86fa8" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed", "diff.changed"],
      "settings": { "foreground": "#d4bc82" }
    },
    {
      "name": "Diff range info",
      "scope": ["meta.diff.range", "meta.diff.index", "meta.diff.header"],
      "settings": { "foreground": "#a89cc8" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f06cb8", "fontStyle": "italic" }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#e86fa8",
        "fontStyle": "italic strikethrough"
      }
    },
    {
      "name": "CSS class",
      "scope": ["entity.other.attribute-name.class.css"],
      "settings": { "foreground": "#7ec8f4" }
    },
    {
      "name": "CSS id",
      "scope": ["entity.other.attribute-name.id.css"],
      "settings": { "foreground": "#d97fff" }
    },
    {
      "name": "CSS pseudo",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "name": "CSS unit",
      "scope": ["keyword.other.unit"],
      "settings": { "foreground": "#d97fff" }
    },
    {
      "name": "Template punctuation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": { "foreground": "#c084fc" }
    },
    {
      "name": "Embedded code",
      "scope": ["meta.embedded", "source.groovy.embedded"],
      "settings": { "foreground": "#eddeff" }
    }
  ]
}
